---
import DocLayout from '../layouts/DocLayout.astro';
---

<DocLayout title="404 — Page Not Found">
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-6 py-16 text-center">
    <div class="text-8xl font-black gradient-text mb-4 select-none">404</div>
    <h1 class="text-2xl font-bold text-dark-800 dark:text-white mb-3">Page not found</h1>
    <p class="text-dark-500 dark:text-dark-400 max-w-md mb-8">
      The documentation page you're looking for doesn't exist or has been moved.
    </p>
    <div class="flex flex-wrap gap-3 justify-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl
               bg-brand-600 text-white font-medium text-sm
               hover:bg-brand-700 transition-colors"
      >
        ← Back to Docs
      </a>
      <a
        href="/docs/introduction"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl
               bg-white dark:bg-dark-800 border border-dark-200 dark:border-dark-700
               text-dark-700 dark:text-dark-300 font-medium text-sm
               hover:border-brand-400 transition-colors"
      >
        Introduction
      </a>
    </div>
  </div>
</DocLayout>
