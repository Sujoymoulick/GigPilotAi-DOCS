---
import { marked } from 'marked';
import DocLayout from '../../layouts/DocLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PrevNext from '../../components/PrevNext.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MarkdownContent from '../../components/MarkdownContent.astro';
import {
  readDocFile,
  extractToc,
  estimateReadingTime,
  getLastModified,
  getAllDocSlugs,
} from '../../lib/markdown';
import { buildNavigation, getAdjacentPages } from '../../lib/navigation';

// Static paths generation — only top-level docs (not api/*)
export async function getStaticPaths() {
  const slugs = getAllDocSlugs().filter(s => !s.startsWith('api/'));
  return slugs.map(slug => ({
    params: { slug },
    props:  { slug },
  }));
}

const { slug } = Astro.props as { slug: string };

const markdown = readDocFile(slug);
if (!markdown) {
  return Astro.redirect('/404');
}

// Parse markdown with marked
marked.setOptions({ gfm: true, breaks: false });

const rawHtml = await marked.parse(markdown);

// Post-process HTML to add anchors to headings and wrap code blocks
function processHtml(html: string): string {
  // Add IDs + anchor links to headings
  html = html.replace(/<(h[2-4])>(.*?)<\/\1>/gs, (_match, tag, content) => {
    const text = content.replace(/<[^>]+>/g, '');
    const id   = text
      .toLowerCase()
      .replace(/`/g, '')
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    return `<${tag} id="${id}">${content} <a href="#${id}" class="anchor-icon ml-2 text-sl-gray-500 no-underline text-base hover:text-sl-accent-high" aria-label="Link to section">#</a></${tag}>`;
  });

  // Method badges
  html = html.replace(/<code>(GET|POST|PUT|PATCH|DELETE)\s+(\/[^<]+)<\/code>/g, (_m, method, path) => {
    const colorMap: Record<string, string> = {
      GET: 'badge-get', POST: 'badge-post', PUT: 'badge-put', PATCH: 'badge-patch', DELETE: 'badge-delete',
    };
    return `<span class="${colorMap[method] ?? 'badge-post'} mr-1">${method}</span><code class="!bg-transparent !text-sl-gray-300 !font-mono">${path}</code>`;
  });

  // Wrap pre blocks with copy button
  html = html.replace(/<pre><code class="language-(\w+)">/g, (_match, lang) => {
    return `<div class="code-block-wrapper"><div class="code-block-header"><span class="text-xs font-mono font-semibold text-sl-gray-500 uppercase tracking-wide">${lang}</span><button class="copy-btn flex items-center gap-1.5 text-xs px-2.5 py-1 rounded bg-white/5 border border-white/10 text-sl-gray-300 hover:bg-white/10 hover:border-white/20 transition-colors font-medium"><svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span></button></div><pre><code class="language-${lang}">`;
  });
  html = html.replace(/<pre><code>/g, () => {
    return `<div class="code-block-wrapper"><div class="code-block-header"><span class="text-xs font-mono font-semibold text-sl-gray-500">text</span><button class="copy-btn flex items-center gap-1.5 text-xs px-2.5 py-1 rounded bg-white/5 border border-white/10 text-sl-gray-300 hover:bg-white/10 hover:border-white/20 transition-colors font-medium"><svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span></button></div><pre><code>`;
  });
  html = html.replace(/<\/code><\/pre>/g, `</code></pre></div>`);

  // Admonitions from > **Note:** patterns
  html = html.replace(
    /<blockquote>\s*<p><strong>(Note|Warning|Tip|Danger|Important):<\/strong>(.*?)<\/p>\s*<\/blockquote>/gs,
    (_m, type, content) => {
      const t    = type.toLowerCase();
      const cls  = t === 'note' ? 'admonition-note' : t === 'warning' ? 'admonition-warning' : t === 'tip' ? 'admonition-tip' : 'admonition-danger';
      const icon = t === 'note' ? 'ℹ️' : t === 'warning' ? '⚠️' : t === 'tip' ? '💡' : '🚨';
      return `<div class="admonition ${cls} my-4 rounded-lg border-l-4 p-4"><p class="font-semibold text-sm mb-1">${icon} ${type}</p><p class="text-sm m-0">${content.trim()}</p></div>`;
    }
  );

  return html;
}

const html    = processHtml(rawHtml);
const toc     = extractToc(markdown);
const readMin = estimateReadingTime(markdown);
const lastMod = getLastModified(slug);

const nav              = buildNavigation();
const currentHref      = `/docs/${slug}`;
const { prev, next }   = getAdjacentPages(nav, currentHref);

// Page title from first heading
const titleMatch = markdown.match(/^#\s+(.+)$/m);
const pageTitle  = titleMatch ? titleMatch[1] : slug;

// Breadcrumb
const isApiDoc   = slug.startsWith('api/');
const breadcrumb = isApiDoc
  ? [{ label: 'API', href: '/docs/api_index' }, { label: pageTitle }]
  : [{ label: pageTitle }];

// Description from first paragraph
const descMatch = markdown.match(/^[^#\n].+/m);
const description = descMatch ? descMatch[0].slice(0, 160) : undefined;
---

<DocLayout title={pageTitle} description={description} slug={slug}>
  <div class="flex gap-8 max-w-[1400px] mx-auto px-6 py-8 lg:py-10">

    <!-- Main content area -->
    <article class="flex-1 min-w-0 animate-fade-in">

      <!-- Breadcrumb -->
      <Breadcrumb items={breadcrumb} />

      <!-- Page header -->
      <div class="mb-8">
        {isApiDoc && (
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-xs font-semibold bg-sl-accent-low text-sl-accent-300 border border-sl-accent-500/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              API Reference
            </span>
          </div>
        )}

        <h1 class="text-3xl lg:text-4xl font-bold text-white mb-3 leading-tight">
          {pageTitle}
        </h1>

        <!-- Meta info -->
        <div class="flex flex-wrap items-center gap-4 text-sm text-sl-gray-300">
          <span class="flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sl-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {readMin} min read
          </span>
          {lastMod && (
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sl-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Updated {new Date(lastMod).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          )}

          <!-- Copy link button -->
          <button
            id="copy-link-btn"
            class="flex items-center gap-1.5 hover:text-white transition-colors"
            aria-label="Copy page link"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sl-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
            <span id="copy-link-text">Copy link</span>
          </button>
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/10 mb-8"></div>

      <!-- Markdown content -->
      <MarkdownContent html={html} />

      <!-- Prev/Next -->
      <PrevNext prev={prev} next={next} />

      <!-- Feedback -->
      <div class="mt-10 p-5 rounded-lg bg-sl-card border border-white/5">
        <p class="text-sm font-semibold text-white mb-3">Was this page helpful?</p>
        <div class="flex items-center gap-2">
          <button
            class="flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium
                   bg-white/5 border border-white/10 text-sl-gray-300
                   hover:border-emerald-500/50 hover:text-emerald-400
                   transition-colors"
            onclick="this.textContent='👍 Thanks!'; this.disabled=true"
          >
            👍 Yes
          </button>
          <button
            class="flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium
                   bg-white/5 border border-white/10 text-sl-gray-300
                   hover:border-red-500/50 hover:text-red-400
                   transition-colors"
            onclick="this.textContent='👎 Noted'; this.disabled=true"
          >
            👎 No
          </button>
          <a
            href={`https://github.com/Sujoymoulick/GigPilotAi-DOCS/issues/new?title=Docs+feedback:+${encodeURIComponent(pageTitle)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="ml-auto text-xs text-sl-gray-500 hover:text-white transition-colors flex items-center gap-1 no-underline"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Report issue
          </a>
        </div>
      </div>
    </article>

    <!-- Right TOC -->
    <TableOfContents toc={toc} />
  </div>
</DocLayout>

<script>
  // Copy link button
  document.getElementById('copy-link-btn')?.addEventListener('click', async () => {
    await navigator.clipboard.writeText(window.location.href).catch(() => {});
    const txt = document.getElementById('copy-link-text');
    if (txt) {
      txt.textContent = 'Copied!';
      setTimeout(() => (txt.textContent = 'Copy link'), 2000);
    }
  });

  // Code copy buttons
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const pre  = btn.closest('.code-block-wrapper')?.querySelector('pre');
      const code = pre?.querySelector('code')?.textContent ?? '';
      await navigator.clipboard.writeText(code).catch(() => {});
      btn.textContent = 'Copied!';
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
  });
</script>
